# VCS
.git

# local state & secrets (never baked into the image)
.env
*.log
data/
dashhome.json

# the frontend image builds its own (frontend/Dockerfile); the backend
# needs none of the frontend source.
frontend/

# build artifacts (rebuilt inside the image)
bin/
dist/

# android build artifacts (rebuilt inside the image)
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
