# dashhome environment configuration
# Copy to .env (or export in your shell / process manager). .env files and
# anything under data/ are never committed.

# --- server -----------------------------------------------------------
# Listen port for the Go binary. Inside Docker the backend container is
# pinned to 3000; to move the published host ports there, use
# BACKEND_PORT / FRONTEND_PORT below.
PORT=3000

# --- Docker Compose published ports -------------------------------------
# Host ports for the backend (API) and frontend (dashboard) services.
# The container-side ports stay fixed (3000 / 8000); only the host side
# moves.
BACKEND_PORT=3000
FRONTEND_PORT=8000

# Where durable state lives (push records, Google OAuth token cache).
DATA_DIR=./data

# Dashboard configuration file (what the dashboard shows). Optional.
CONFIG_FILE=./dashhome.json

# --- Home Assistant ----------------------------------------------------
# Long-lived access token (HA: Profile -> Security -> Long-lived access tokens).
HOMEASSISTANT_URL=https://ha.example.com
HOMEASSISTANT_TOKEN=eyJhbGciOi...

# --- Google Calendar (pick ONE mode) ------------------------------------

# Mode A: service account (recommended for a home server).
#   - Create a service account in Google Cloud, enable the "Google Calendar
#     API", download its JSON key into backend/.keys/ (gitignored; the
#       docker-compose stack bind-mounts that directory read-only into
#       the backend container at /app/backend/.keys, so no credentials
#       are baked into the images).
#   - Share the calendar you want to show with the service account's email.
#   - Optional domain-wide delegation: set GOOGLE_DOMAIN to a Workspace user
#     email (the service account then acts as that user).
#   - The path is relative to the backend container's WORKDIR (/app), so
#     ./backend/.keys/<key>.json resolves to the mounted key file; the
#     host file must be readable by the container's non-root user.
GOOGLE_APPLICATION_CREDENTIALS=./backend/.keys/<key>.json
# GOOGLE_DOMAIN=you@yourworkspace.com

# Mode B: 3-legged OAuth (personal Google account).
#   - Create an OAuth client (type: Web application) in Google Cloud.
#   - Authorized redirect URI: https://<your-host>/api/auth/google/callback
#   - Run dashhome, then open /api/auth/google/login and sign in once.
#GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
#GOOGLE_REDIRECT_URI=https://your-host/api/auth/google/callback
#GOOGLE_TOKEN_CACHE=./data/google-token.json

# Mode C: static access token (development only; expires).
#GOOGLE_ACCESS_TOKEN=ya29.xxxx

# Advanced: override the Calendar API base URL (proxy or tests).
#GOOGLE_API_ENDPOINT=https://calendar.example.com

# --- Hermes chat --------------------------------------------------------
# Base URL of the Hermes API (no trailing slash) and the chat path.
HERMES_BASE_URL=https://hermes.example.com
HERMES_CHAT_PATH=/chat/completions
# Request header sent with each chat call (name + full value).
HERMES_AUTH_HEADER=Authorization
HERMES_AUTH_VALUE=Bearer sk-hermes-xxx

# --- Hermes push ---------------------------------------------------------
# Shared token Hermes must present when pushing markdown to
# POST /api/hermes/push (Authorization: Bearer <token>, X-Hermes-Token, or
# ?token=). Leave empty to disable push ingestion.
HERMES_PUSH_TOKEN=change-me-push-token
